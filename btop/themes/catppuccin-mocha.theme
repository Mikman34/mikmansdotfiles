# Catppuccin Mocha theme for btop

# Background and text
theme[main_bg]="#1e1e2e"
theme[main_fg]="#cdd6f4"
theme[title]="#cdd6f4"
theme[selected_bg]="#313244"
theme[selected_fg]="#cdd6f4"

# Highlighted text
theme[highlight_fg]="#cba6f7"

# Process list
theme[proc_misc]="#a6adc8"

# CPU
theme[cpu_box]="#313244"
theme[cpu_graph_bg]="#1e1e2e"
theme[cpu_graph_fg]="#89b4fa"

# Memory
theme[mem_box]="#313244"
theme[mem_graph_bg]="#1e1e2e"
theme[mem_graph_fg]="#a6e3a1"
theme[swap_graph_fg]="#fab387"

# Network
theme[net_box]="#313244"
theme[net_graph_bg]="#1e1e2e"
theme[net_graph_fg]="#94e2d5"
theme[net_graph_rx]="#a6e3a1"
theme[net_graph_tx]="#f38ba8"

# Processes
theme[proc_box]="#313244"
theme[proc_color]="#89b4fa"
theme[proc_gradient]="false"

# Boxes and borders
theme[div_line]="#45475a"
theme[div_color]="#45475a"

# Meter colors
theme[meter_bg]="#313244"
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# Misc
theme[inactive_fg]="#585b70"
theme[graph_text]="#a6adc8"
theme[misc_color]="#cba6f7"
